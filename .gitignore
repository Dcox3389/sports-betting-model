# Raw API caches — regenerated by the fetch scripts, ~35MB, not source.
# Three exceptions: the football history and division map are small (524KB)
# and expensive to refetch, and the scheduled cloud run needs them because it
# starts from a clean checkout with no cache.
data/*
!data/nfl_games.json
!data/cfb_games.json
!data/cfb_divisions.json

# Generated reports. Keep the newsletters and the archive page; drop bulk CSVs.
out/*.csv
out/archive_issues.json

__pycache__/
*.pyc
.venv/
